# ==============================================================================
# 1. BUILDER STAGE
# ==============================================================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files and install dependencies
COPY nyayasetu/frontend/package.json nyayasetu/frontend/package-lock.json* ./
RUN npm ci || npm install

# Copy source code and build the React app
COPY nyayasetu/frontend/ ./
RUN npm run build

# ==============================================================================
# 2. RUNTIME STAGE (Nginx)
# ==============================================================================
FROM nginx:alpine

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom Nginx configuration (to be mounted or baked in via docker-compose)
# We will rely on docker-compose volume mounts or a global proxy, but we provide a default basic config here
COPY nginx/frontend.conf /etc/nginx/conf.d/default.conf

# Copy built static files from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose HTTP port
EXPOSE 80

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
